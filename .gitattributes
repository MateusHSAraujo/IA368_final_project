# Macros used by "My project/.gitattributes" (Unity rules); Git only accepts [attr] in the top-level file
# Git LFS is disabled (no LFS budget on the GitHub account): the Unity template's
# "lfs" rules now mean plain binary files. To re-enable LFS, restore:
#   [attr]lfs filter=lfs diff=lfs merge=lfs -text
[attr]lfs               binary
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

* text=auto
*.md     text eol=lf
*.py     text eol=lf
*.lua    text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf

# CoppeliaSim scenes (binary, up to ~30 MB each)
*.ttt    binary
